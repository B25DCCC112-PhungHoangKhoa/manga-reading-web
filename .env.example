# Public APIs are integrated dynamically without requiring API keys for public reads:
# AniList GraphQL: https://graphql.anilist.co
# MangaDex REST: https://api.mangadex.org

# Optional custom app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional custom User-Agent for MangaDex API requests
MANGADEX_USER_AGENT=MangaWeb/1.0 (https://github.com/mangaweb)

# Cache TTL (in seconds)
CACHE_TTL_DEFAULT=600
CACHE_TTL_CHAPTERS=900

# Optional Cloudflare Worker Proxy URL for CORS bypass
NEXT_PUBLIC_PROXY_URL=https://your-worker-subdomain.workers.dev

